---
import { ANALYTICS } from 'astrowind:config';

const id = ANALYTICS?.vendors?.googleAnalytics?.id;
const usePartytown = ANALYTICS?.vendors?.googleAnalytics?.partytown;
---

{
  id ? (
    <>
      {usePartytown ? (
        <script type="text/partytown" src={`https://www.googletagmanager.com/gtag/js?id=${id}`}></script>
      ) : (
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${id}`}></script>
      )}
      <script is:inline define:vars={{ id }}>
        window.dataLayer = window.dataLayer || [];
        // eslint-disable-next-line prefer-rest-params
        function gtag() { window.dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', id);
      </script>
    </>
  ) : null
}
